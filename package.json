    "dev": "node mcp/server.mjs",
    "smoke": "node plugins/cursor-react/dist/smoke-test.mjs",
    "test": "pnpm build && node plugins/cursor-react/dist/smoke-test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "license": "MIT",
  "author": "thisVioletHydra",
  "repository": {
    "type": "git",
