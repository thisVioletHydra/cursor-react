{
  "name": "cursor-react",
  "version": "19.2.2",
  "private": false,
  "description": "React development plugin for Cursor and Codex: official docs, best practices, Zustand and local MCP linting.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync-docs": "node scripts/sync-docs.mjs",
    "build": "node scripts/build.mjs",
